// Uses the custom claims {orgId, role} that Cloud Functions set on every account.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function img() { return request.resource.contentType.matches('image/(png|jpeg|webp)') && request.resource.size < 2 * 1024 * 1024; }
    match /companies/{orgId}/logo/{file} {
      allow read: if request.auth != null && request.auth.token.orgId == orgId;
      allow write: if request.auth != null && request.auth.token.orgId == orgId && request.auth.token.role == 'admin' && img();
    }
    match /companies/{orgId}/users/{uid}/{file} {
      allow read: if request.auth != null && request.auth.token.orgId == orgId;
      allow write: if request.auth != null && request.auth.token.orgId == orgId && request.auth.uid == uid && img();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
